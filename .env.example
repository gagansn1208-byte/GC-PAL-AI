# PayPal sandbox credentials (https://developer.paypal.com/dashboard/applications/live)
# Leave empty to run in "simulate payment" demo mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI comparison engine (OpenAI-compatible endpoint)
# Leave empty to fall back to the built-in smart rules engine.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
